APP_NAME="Stock Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MariaDB / MySQL (driver mysql) - sesuai setup modul
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pabwe_p7_stock
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# OpenAI (isi sendiri di .env, JANGAN di-commit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
